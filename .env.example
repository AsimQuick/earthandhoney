# ---
# file: .env.example
# project: earthandhoney
# purpose: Environment variable template — copy to .env and fill in values
# created-by: project-lead
# ---

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/earthandhoney

# Redis (if applicable)
REDIS_URL=redis://redis:6379/0

# Application
SECRET_KEY=change-me-in-production
DEBUG=true
PORT=8000

# Payload CMS — required at boot; Payload refuses to initialize without it
PAYLOAD_SECRET=change-me-in-production

# Cloudflare R2 (object storage for media — see US-2)
R2_ACCOUNT_ID=change-me-in-production
R2_ACCESS_KEY_ID=change-me-in-production
R2_SECRET_ACCESS_KEY=change-me-in-production
R2_BUCKET=change-me-in-production
R2_ENDPOINT=https://change-me-in-production.r2.cloudflarestorage.com

# External APIs (fill in as needed)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Public site URL (used for canonical links, OG tags, sitemap — see US-13/sprint-2 public pages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker
COMPOSE_PROJECT_NAME=earthandhoney

# Backstage (forked PicPeak, vendor/picpeak — see US-16)
# Only loaded when the "backstage" Docker Compose profile is started
# (`docker compose --profile backstage up -d`). Every var below has a
# built-in fallback in docker-compose.yml, so Backstage boots even if
# these are left unset — set real values before any non-local deployment.

# Runtime mode for the vendored backend (affects logging verbosity and
# cookie Secure-flag defaults) — see vendor/picpeak/.env.example. Named
# BACKSTAGE_NODE_ENV, not the bare NODE_ENV: this file is shared with the
# "web" service via env_file, and a bare NODE_ENV here would leak into the
# Next.js app's own dev/test container and break Jest/RTL.
BACKSTAGE_NODE_ENV=production

# Dedicated Postgres database for Backstage (separate from the Next.js
# app's own "db" service so the two systems' schemas never collide — see
# AC-16.1/16.2). Not real credentials; change before any shared environment.
BACKSTAGE_DB_NAME=backstage
BACKSTAGE_DB_USER=backstage
BACKSTAGE_DB_PASSWORD=change-me-in-production

# Signs Backstage's auth session tokens. Generate your own with
# `openssl rand -base64 64` — never reuse the Next.js app's SECRET_KEY/PAYLOAD_SECRET.
BACKSTAGE_JWT_SECRET=change-me-in-production

# Seeds the one Backstage administrator account on first boot (AC-16.5).
# Change before any non-local deployment; the photographer's real login
# is created/rotated through the Backstage admin UI afterwards, not here.
BACKSTAGE_ADMIN_USERNAME=admin
BACKSTAGE_ADMIN_EMAIL=admin@example.com
BACKSTAGE_ADMIN_PASSWORD=change-me-in-production

# Base URL the vendored frontend's build uses to reach the backend API.
# Local Docker Compose proxies /api through the vendored nginx config, so
# the default below is correct out of the box — only change this if you
# rebuild the frontend image against a different backend origin.
BACKSTAGE_API_URL=/api

# Base URL the Frontstage "web" service (this Next.js app) uses to reach the
# Backstage backend server-to-server, per PAYLOAD_PICPEAK_API_CONTRACT.md
# (src/lib/backstageClient.ts, US-25 AC-25.2). Docker network hostname, never
# localhost — the "web" and "backstage-backend" containers share the compose
# network. Has a built-in fallback in src/lib/backstageClient.ts matching
# this default, so it only needs setting here if the hostname/port changes.
BACKSTAGE_BACKEND_URL=http://backstage-backend:3000

# Email (Backstage/operational email queue — see US-17 AC-17.6)
EMAIL_ENABLED=true
SMTP_SERVER=change-me-in-production
SMTP_PORT=587
SMTP_USERNAME=change-me-in-production
SMTP_PASSWORD=change-me-in-production
SENDER_EMAIL=change-me-in-production@example.com
EMAIL_USE_SSL=true

# Stripe (payment path — see US-20). Flat names, no _TEST/_LIVE suffix:
# the reference project's convention is that a variable's own value
# carries its mode (sk_test_/sk_live_, pk_test_/pk_live_, or the mode a
# Price ID was created under), not a separate mode flag. See
# STRIPE_PORT_REPORT.md sections 4 and 6 for the full convention and the
# key-pairing rule this depends on.

# Server-side only — read by the backend to call the Stripe API, never
# sent to the browser. Starts with sk_test_ (test mode) or sk_live_
# (live mode); must be the same mode as every other STRIPE_* value below.
STRIPE_SECRET_KEY=change-me-in-production

# Safe to expose to the browser — handed to Stripe.js client-side to
# initialize payment collection. Starts with pk_test_ or pk_live_; must
# match STRIPE_SECRET_KEY's mode (a publishable key from the other mode
# creates PaymentMethods the secret key cannot see).
STRIPE_PUBLISHABLE_KEY=change-me-in-production

# Stripe Price ID for the maintenance-plan line item (subscription
# price). Created in Stripe's Test or Live dashboard; must be from the
# same mode as STRIPE_SECRET_KEY — a Price ID from the other mode does
# not exist in that key's data partition and Stripe rejects it as
# "No such price".
STRIPE_PRICEMAINT_ID=change-me-in-production

# Stripe Price ID for the optional email add-on line item (subscription
# price). Same mode-matching rule as STRIPE_PRICEMAINT_ID above.
STRIPE_PRICEEMAIL_ID=change-me-in-production

# Stripe Price ID for the one-time development/session fee. Same
# mode-matching rule as STRIPE_PRICEMAINT_ID above.
STRIPE_PRICEDEV_ID=change-me-in-production

# Shared secret Backstage signs its outbound gallery-change webhook
# deliveries with (PAYLOAD_PICPEAK_API_CONTRACT.md row 5 / Flow C — see
# US-26 AC-26.1). Frontstage's receiver route recomputes the
# X-PicPeak-Signature HMAC-SHA256 header with this same value before
# trusting any webhook payload; a request that doesn't verify is
# rejected outright. Generate with `openssl rand -hex 32`; must match the
# secret shown once when the webhook subscription is registered through
# Backstage's POST /api/admin/webhooks.
PICPEAK_WEBHOOK_SECRET=change-me-in-production

# Public HTTPS URL of this Frontstage app's own webhook receiver route
# (src/app/(frontend)/api/webhooks/picpeak/route.ts, US-26 AC-26.1/26.6) —
# the same URL to register with Backstage's POST /api/admin/webhooks so it
# knows where to POST gallery-change deliveries
# (PAYLOAD_PICPEAK_API_CONTRACT.md row 5). Must be the real, publicly
# reachable production domain, not a Compose service hostname: the local
# live-proof harness (WEBHOOK_LIVE_PROOF.md section (b),
# scripts/webhook-live-proof-setup.sh) registers a different
# `http://web:3000/api/webhooks/picpeak` value instead, because there
# Backstage reaches Frontstage over the shared Docker network rather than
# the public internet.
PICPEAK_WEBHOOK_RECEIVER_URL=https://change-me-in-production.example.com/api/webhooks/picpeak